upstream backend_autenticacion {
    server ${IP_BACKEND_PRIVADA}:8081;
}
upstream backend_clinico {
    server ${IP_BACKEND_PRIVADA}:8082;
}
upstream backend_agenda {
    server ${IP_BACKEND_PRIVADA}:8083;
}
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    location /autenticacion/ {
        proxy_pass http://backend_autenticacion/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /clinico/ {
        proxy_pass http://backend_clinico/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /agenda/ {
        proxy_pass http://backend_agenda/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
