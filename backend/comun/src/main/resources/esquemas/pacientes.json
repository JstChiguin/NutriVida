{
  "bsonType": "object",
  "required": ["usuarioId", "nombreCompleto", "correo", "activo", "nutricionistasAutorizados", "creadoEn"],
  "properties": {
    "usuarioId": { "bsonType": "objectId" },
    "nombreCompleto": { "bsonType": "string", "minLength": 3, "maxLength": 120 },
    "rut": { "bsonType": ["string", "null"], "pattern": "^\\d{7,8}-[\\dK]$" },
    "correo": { "bsonType": "string" },
    "telefono": { "bsonType": ["string", "null"] },
    "fechaNacimiento": { "bsonType": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sexo": { "enum": ["FEMENINO", "MASCULINO", "OTRO", "NO_INFORMA", null] },
    "activo": { "bsonType": "bool" },
    "nutricionistasAutorizados": { "bsonType": "array", "items": { "bsonType": "objectId" } },
    "creadoEn": { "bsonType": "date" }
  }
}
